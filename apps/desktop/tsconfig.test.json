{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "composite": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  },
  "include": ["test/**/*", "playwright.config.ts", "vitest.config.ts", "src/shared/**/*", "src/main/**/*", "src/preload/index.d.ts", "src/renderer/src/jobs/format.ts", "src/renderer/src/jobs/types.ts"]
}
