<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ad-hoc signatures have no Team ID, so the hardened runtime's library validation refuses
	     to map libpq.5.dylib into initdb/psql/pg_dump and the server's modules (plpgsql,
	     vector, pg_trgm) into postgres. See README.md. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
